{
  "name": "@ryze-digital/legacy-boilerplate",
  "description": "",
  "license": "MIT",
  "version": "0.1.0",
  "author": "RYZE Digital GmbH <kontakt@ryze-digital.de> (https://www.ryze-digital.de/)",
  "main": "src/scripts/main.js",
  "type": "module",
  "scripts": {
    "check-engine": "node check-engine.js",
    "lint": "npm-run-all --parallel lint:*",
    "lint:scripts": "prettier src/scripts tests/scripts ./*.js --check && eslint src tests/scripts ./*.js",
    "lint:styles": "prettier src/styles/** --check && stylelint src/styles/**",
    "lint-fix": "npm-run-all --parallel lint-fix:* --continue-on-error",
    "lint-fix:scripts": "prettier src/scripts tests/scripts ./*.js --write && npm run lint:scripts -- --fix",
    "lint-fix:styles": "prettier src/styles/** --write && npm run lint:styles -- --fix",
    "test": "npm run test:scripts",
    "test:scripts": "jest",
    "test:scripts:coverage": "jest --coverage",
    "build": "npm-run-all --parallel lint:* copy:* build:* --continue-on-error",
    "build:scripts": "webpack",
    "build:styles": "npm-run-all sass:build lightning",
    "build:images": "imagemin src/pics --out-dir=__OUTPUT_PATH__ --plugin=mozjpeg --plugin=gifsicle --plugin=optipng --plugin=svgo",
    "copy:fonts": "copyfiles src/fonts/**/* __OUTPUT_PATH__ --flat",
    "watch": "npm-run-all --parallel watch:*",
    "watch:scripts": "webpack --watch",
    "watch:styles": "npm run sass:watch",
    "sass:build": "sass src/styles:__OUTPUT_PATH__ --no-source-map --load-path=node_modules",
    "sass:watch": "sass src/styles:__OUTPUT_PATH__ --no-source-map --load-path=node_modules --watch --poll",
    "lightning": "lightningcss --browserslist __OUTPUT_PATH__/*.css --output-dir __OUTPUT_PATH__ --minify",
    "prebuild": "npm run check-engine && node pre-build.js",
    "pre-production": "grunt pre-production --gruntfile Gruntfile.cjs"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@ryze-digital/eslint-config-website": "^2.0.0",
    "@ryze-digital/prettier-config-website": "^2.0.0",
    "@ryze-digital/stylelint-config-website": "^2.0.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "check-engine": "^1.14.0",
    "copyfiles": "^2.4.1",
    "imagemin": "^9.0.1",
    "imagemin-cli": "^8.0.0",
    "imagemin-mozjpeg": "^10.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^17.0.0",
    "lightningcss": "^1.33.0",
    "lightningcss-cli": "^1.33.0",
    "npm-run-all2": "^9.0.4",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.4.3",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
    "@ryze-digital/js-utilities": "^1.2.0",
    "@ryze-digital/scss-utilities": "^1.1.2",
    "core-js": "^3.51.0",
    "lazysizes": "^5.3.2"
  },
  "browserslist": [
    "> 0.5%",
    "not IE > 0"
  ],
  "engines": {
    "node": ">=24.15",
    "npm": ">=11"
  }
}
