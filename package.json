{
  "name": "@ryze-digital/create-website",
  "description": "Sets up build tools and default folder structure",
  "license": "UNLICENSED",
  "version": "2.0.0",
  "author": "RYZE Digital GmbH <kontakt@ryze-digital.de> (https://www.ryze-digital.de/)",
  "main": "index.js",
  "type": "module",
  "repository": "github:ryze-digital/create-website",
  "bin": {
    "create-website": "index.js"
  },
  "files": [
    "boilerplates",
    "src",
    "index.js"
  ],
  "scripts": {
    "lint": "npm run lint:scripts",
    "lint:scripts": "prettier src ./*.js --check && eslint src ./*.js",
    "lint-fix": "npm run lint-fix:scripts",
    "lint-fix:scripts": "prettier src ./*.js --write && npm run lint:scripts -- --fix"
  },
  "dependencies": {
    "@inquirer/core": "^12.1.1",
    "@inquirer/prompts": "^8.8.1",
    "chalk": "^6.0.1"
  },
  "devDependencies": {
    "@ryze-digital/eslint-config-website": "^2.0.0",
    "@ryze-digital/prettier-config-website": "^2.0.0",
    "@types/node": "^24.19.2"
  },
  "engines": {
    "node": ">=24.15"
  },
  "keywords": [
    "initializer",
    "create",
    "npm"
  ]
}
